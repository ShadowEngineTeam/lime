<xml>

	<include name="${HXCPP}/build-tool/BuildCommon.xml" />

	<files id="main">

		<file name="Main.cpp" />

	</files>

	<target id="main" output="::APP_FILE::${DBG}" tool="linker" toolid="exe">

		<files id="main" />
		::foreach ndlls::
		<lib name="::path::" />::end::
		<lib name="libApplicationMain${DBG}${LIBEXT}" />

		<flag value="-sFETCH=1" />
		<flag value="-sFORCE_FILESYSTEM=1" />
		<flag value="-sMAXIMUM_MEMORY=4GB" />
		<flag value="-sINVOKE_RUN=0" />
		<flag value="-sEXIT_RUNTIME=0" />
		<flag value="-sEXPORTED_RUNTIME_METHODS=['callMain','FS']" />
		<flag value="-lidbfs.js" />
		<flag value="--use-port=emdawnwebgpu" />

	</target>

	<target id="default">

		<target id="main" />

	</target>

</xml>
